# setup.py generates .env with a random password for the local database.
DATABASE_URL=postgresql+psycopg://equitylens:CHANGE_ME@127.0.0.1:55432/equitylens
POSTGRES_PASSWORD=CHANGE_ME
DATA_DIR=data
# Not an SEC API key. Enter an app label and an email you control, e.g. EquityLens you@your-domain.com.
# Leave blank to disable SEC requests.
SEC_USER_AGENT=
API_BASE_URL=http://127.0.0.1:8001
# Local live mode; cloud_app.py defaults to a labelled public sample demo.
EQUITYLENS_DATA_MODE=live

# Optional connections for on-demand research. Database configuration above is legacy-only.
TAVILY_API_KEY=
EODHD_API_KEY=
# Optional API-based answer generation. Both the key and model must be set.
# Keep these blank until you choose a provider and want API-generated answers.
LLM_API_KEY=
LLM_MODEL=
# OpenAI Responses is the default. Use chat_completions for a compatible gateway.
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_MODE=responses
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
# Optional; set only if your chosen model supports this reasoning parameter.
LLM_REASONING_EFFORT=
RESEARCH_TTL_SECONDS=1800
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_READ_MAX_SOURCES=4
# RAG_MODEL_CACHE optionally overrides the workspace's general model-weight cache.
